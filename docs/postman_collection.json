{
  "info": {
    "name": "API Produk - Week 10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET semua produk",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
    {
      "name": "GET produk by id (sukses)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "1"
          ]
        }
      }
    },
    {
      "name": "GET produk by id (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "9999"
          ]
        }
      }
    },
    {
      "name": "POST sukses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Penghapus\",\n  \"price\": 2000\n}"
        }
      }
    },
    {
      "name": "POST validasi gagal (name hilang)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 2000\n}"
        }
      }
    },
    {
      "name": "POST validasi gagal (price teks)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Penggaris\",\n  \"price\": \"abc\"\n}"
        }
      }
    },
    {
      "name": "PUT sukses (ganti id sesuai data)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"name\": \"Buku Tulis Besar\",\n  \"price\": 6000\n}"
        }
      }
    },
    {
      "name": "PUT validasi gagal (id hilang)",
      "request": {
        "method": "PUT",
        "header": [
          {
