        }
      }
    },
    {
      "name": "PUT 404 (id tidak ada)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 9999,\n  \"name\": \"Hantu\",\n  \"price\": 1000\n}"
